# Copy to .env and fill in your values
ANTHROPIC_API_KEY=your-anthropic-key-here

# Alpha Vantage — real-time forex data (https://www.alphavantage.co/support/#api-key)
# Free tier: 25 requests/day, 5/minute
ALPHAVANTAGE_API_KEY=your-alphavantage-key-here

# Managed Agent IDs — generated by running: python setup_agent.py --write
# Leave blank if using the CLI REPL (main.py) only.
MANAGED_AGENT_ID=
MANAGED_AGENT_VERSION=
MANAGED_AGENT_ENV_ID=
