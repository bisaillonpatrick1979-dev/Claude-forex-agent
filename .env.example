# ═══════════════════════════════════════════════════════════
# VARIABLES D'ENVIRONNEMENT — TradingLab IA
# Copier ce fichier en .env.local et remplir les valeurs
# ATTENTION : Ne jamais committer le fichier .env.local !
# ═══════════════════════════════════════════════════════════

# ─── Supabase (obligatoire) ──────────────────────────────
# Obtenir depuis : https://app.supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete

# ─── Mode IA ─────────────────────────────────────────────
# 'mock' = réponses simulées réalistes (défaut, aucun coût)
# 'live' = appels réels aux API IA configurées
IA_MODE=mock

# ─── Clés API IA (optionnelles si IA_MODE=mock) ──────────
# Anthropic Claude : https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini : https://aistudio.google.com/
GOOGLE_GEMINI_API_KEY=

# OpenAI GPT : https://platform.openai.com/
OPENAI_API_KEY=

# ─── Sécurité Cron ───────────────────────────────────────
# Secret pour sécuriser l'endpoint /api/cycle (choisir une chaîne aléatoire longue)
CRON_SECRET=changez-moi-par-une-valeur-aleatoire-longue

# ─── Configuration Application ───────────────────────────
NEXT_PUBLIC_APP_NAME=TradingLab IA
NEXT_PUBLIC_VERSION=0.1.0
